<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		OmniTracker is intentionally NOT sandboxed.
		Global CGEvent taps (input metrics) and AppleScript browser queries
		require running outside the App Sandbox. Do not add
		com.apple.security.app-sandbox here.
	-->
</dict>
</plist>
